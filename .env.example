# Copie este arquivo para .env (desenvolvimento local) ou cadastre as variáveis no Railway.

# --- Servidor ---
PORT=3000
# URL pública usada nos links dos e-mails. No Railway é preenchida automaticamente a partir do domínio do serviço.
PUBLIC_URL=http://localhost:5173
# Chave longa e aleatória (mínimo 32 caracteres) que assina as sessões do painel.
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# --- Acesso ao painel (sem login) ---
# Chave mestra (mínimo 32 caracteres). O painel é aberto pelo link:  <PUBLIC_URL>/acesso#<ADMIN_ACCESS_KEY>
# Trocar este valor invalida imediatamente todas as sessões abertas com a chave antiga.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_ACCESS_KEY=
ADMIN_NAME=Direção do Campus

# --- Banco de dados ---
# Sem DATABASE_URL o servidor usa PGlite (Postgres embutido) em .data/pglite — ideal para desenvolvimento.
# No Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Pasta de dados (uploads e PGlite). No Railway, monte um volume em /data e use DATA_DIR=/data
DATA_DIR=.data

# Cria projetos de demonstração na primeira inicialização (podem ser removidos pelo painel)
SEED_DEMO=true

# --- E-mail (escolha UM provedor; sem nenhum, os envios são apenas simulados no log) ---
MAIL_FROM="Campus Ita+ <nao-responda@seudominio.com.br>"
# Resend (https://resend.com) — requer domínio verificado
RESEND_API_KEY=
# Brevo (https://brevo.com) — aceita remetente verificado sem domínio próprio
BREVO_API_KEY=
# SMTP (o Railway bloqueia SMTP fora do plano Pro)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
